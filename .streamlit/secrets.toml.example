# Copie para .streamlit/secrets.toml (local) ou cole em Settings > Secrets (Streamlit Community Cloud).
# NUNCA faça commit do secrets.toml.

[firestore]
project_id = "reserva-salas-bb922"

# Chave de CONTA DE SERVIÇO (recomendado). Gere uma NOVA em:
# Firebase Console > Configurações do projeto > Contas de serviço > Gerar nova chave privada
# e copie cada campo do JSON baixado. A private_key deve ficar em UMA linha, com \n literais.
[gcp_service_account]
type = "service_account"
project_id = "reserva-salas-bb922"
private_key_id = "COLE_AQUI"
private_key = "-----BEGIN PRIVATE KEY-----\nCOLE_AQUI\n-----END PRIVATE KEY-----\n"
client_email = "firebase-adminsdk-xxxxx@reserva-salas-bb922.iam.gserviceaccount.com"
client_id = "COLE_AQUI"
token_uri = "https://oauth2.googleapis.com/token"

# ALTERNATIVA mais à prova de erro para a private_key: aspas simples triplas (sem processamento
# de escapes), colando as linhas da chave exatamente como estão no arquivo .json, com quebras reais:
#
# private_key = '''-----BEGIN PRIVATE KEY-----
# ...linhas da chave...
# -----END PRIVATE KEY-----
# '''
#
# TODOS os 6 campos são obrigatórios: type, project_id, private_key_id, private_key, client_email, token_uri.
